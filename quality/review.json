    {
      "id": "worksheet-formula",
      "kind": "formula",
      "statement": "Net rate=(ending-starting)/minutes; receipts=(ending-starting+spending)/minutes; comparison=run2 net-run1 net.",
      "sourceIds": [
        "implementation",
        "interactions"
      ],
      "support": "Accounting identity end=start+receipts-spending under disclosed inputs; implementation read and browser outputs independently compared to hand-computed synthetic examples.",
      "method": "Reconstruct receipts by adding recorded spending to balance change, divide each by elapsed minutes, then subtract first net rate from second. JavaScript finite range checked; display rounds to at most 2 decimal places. This is user-entered interval accounting, not a game mechanism.",
      "units": "Balances/spending: same game balance unit; elapsed time: minutes; outputs: those units per minute. Not real-world currency.",
      "assumptions": "All spending recorded; same units and comparable version/conditions; exclude resets, refunds, transfers, one-off rewards and unrecorded purchases. Observed comparison is not causality or a future prediction.",
      "calibration": [
        {
          "input": {
            "minutes": 2,
            "start": 100,
            "end": 160,
            "spending": 20
          },
          "expected": 30,
